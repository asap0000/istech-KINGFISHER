<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NOTE: The INTERNET permission is intentionally NOT declared.
      Without it, this app is technically incapable of sending any captured
      image off the device. All originals stay encrypted in app-private storage.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".PrivacyCameraApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrivacyCamera"
        tools:targetApi="34">

        <!--
          Configuration changes are handled in place rather than by recreating the activity.

          Recreation throws away whatever the UI was holding, and one of the things it holds is
          the recovery code: shown once, on screen, and deliberately not written anywhere until
          the user confirms they copied it down. Recreation also goes through ON_PAUSE, which
          locks the vault — so the app comes back locked, with the code gone and no trace that
          it ever existed.

          Measured on the OPPO (2026-09-08): with MG58-TZYW-86V2-T2S6 on screen, switching the
          phone to dark mode left the app at its lock screen and that code was never stored.
          This phone changes to dark mode on a schedule, so it needs no help from the user to
          happen — which is the likeliest reason a first-run code went missing twice while the
          app sat waiting for a passphrase to be typed.

          Safe to declare: every resource in this app is unqualified (no -night, no size
          buckets), the theme is picked in Compose by isSystemInDarkTheme(), and Compose
          updates LocalConfiguration and recomposes by itself. Orientation is pinned to
          portrait, so that one cannot arise at all.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|fontScale|density|screenSize|smallestScreenSize|screenLayout|layoutDirection|locale|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.PrivacyCamera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
